+// Grouped MoE path for batched mul_mat_id (prefill): quantize every src1 row once, list the
+// routed (token, slot) rows sorted by expert, and run one GEMV launch per weight tensor instead
+// of one small GEMM per expert. ids may contain -1 (hot/cold expert split): those rows are
+// skipped and their dst rows zeroed. Returns false when the shapes or the type are not handled.
+static bool ggml_sycl_mul_mat_id_grouped(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                                         const ggml_tensor * src1, const ggml_tensor * ids,
+                                         ggml_tensor * dst, const char * ids_host) {
+    if (getenv("GGML_SYCL_DISABLE_MOE_GROUPED")) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src1) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    const int64_t ne10 = src1->ne[0];
+    if (ne10 != src0->ne[0] || ne10 % QK8_1 != 0) {
+        return false;
+    }
+    if (ids->nb[0] != sizeof(int32_t)) {
+        return false;
+    }
+    const ggml_tensor_extra_gpu * src0_extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (src0_extra && src0_extra->optimized_feature.reorder) {
+        return false; // reordered (SoA) weights use a different block layout
+    }
+    if (!ggml_sycl_mul_mat_vec_q_id_rows_supported(src0->type)) {
+        return false;
+    }
+
+    const int64_t n_as     = src0->ne[2];
+    const int64_t n_ids    = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    const int64_t ne11     = src1->ne[1];
+    const int64_t ne12     = src1->ne[2];
+    if (ne12 != n_tokens || (ne11 != 1 && ne11 != n_ids) || dst->ne[1] != n_ids || dst->ne[2] != n_tokens) {
+        return false;
+    }
+
+    const queue_ptr stream = ctx.stream();
+
+    // routed rows grouped by expert (counting sort), skipping ids < 0
+    std::vector<int64_t> counts(n_as + 1, 0);
+    for (int64_t t = 0; t < n_tokens; t++) {
+        for (int64_t s = 0; s < n_ids; s++) {
+            const int32_t e = *(const int32_t *) (ids_host + t*ids->nb[1] + s*ids->nb[0]);
+            if (e < 0) {
+                continue;
+            }
+            GGML_ASSERT(e < n_as);
+            counts[e + 1]++;
+        }
+    }
+    for (int64_t e = 0; e < n_as; e++) {
+        counts[e + 1] += counts[e];
+    }
+    const int64_t n_routed = counts[n_as];
+    const int64_t n_total  = n_tokens * n_ids;
+
+    // one GEMV per routed row re-reads the expert weights for every row; past a few rows per
+    // expert the per-expert dequantize + GEMM loop reuses them and wins (measured: 73 vs 130 tok/s
+    // at 40 rows per expert on a B580). GGML_SYCL_MOE_GROUPED_MAX_ROWS overrides the threshold.
+    {
+        static const int64_t max_rows_per_expert = getenv("GGML_SYCL_MOE_GROUPED_MAX_ROWS") ? atoll(getenv("GGML_SYCL_MOE_GROUPED_MAX_ROWS")) : 8;
+        if (n_routed > max_rows_per_expert * n_as) {
+            return false;
+        }
+    }
+
+    if (n_routed < n_total) {
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memset(dst->data, 0, ggml_nbytes(dst))));
+    }
+    if (n_routed == 0) {
+        return true;
+    }
+
+    std::vector<mmid_grouped_row> rows(n_routed);
+    std::vector<int64_t> next(counts.begin(), counts.end() - 1);
+    for (int64_t t = 0; t < n_tokens; t++) {
+        for (int64_t s = 0; s < n_ids; s++) {
+            const int32_t e = *(const int32_t *) (ids_host + t*ids->nb[1] + s*ids->nb[0]);
+            if (e < 0) {
+                continue;
+            }
+            const int64_t k = next[e]++;
+            rows[k].expert   = e;
+            rows[k].src1_row = (int32_t) (ne11 == 1 ? t : t*ne11 + s);
+            rows[k].dst_row  = (int32_t) (t*n_ids + s);
+        }
+    }
+
+    // quantize all src1 rows to Q8_1 once
+    const int    src1_padded_cols = GGML_PAD((int) ne10, MATRIX_ROW_PADDING);
+    const size_t bytes_per_qrow   = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+    ggml_sycl_pool_alloc<char> src1_q8(ctx.pool(), (size_t) ne11 * ne12 * bytes_per_qrow);
+    quantize_row_q8_1_sycl<quantize_q8_1>((const float *) src1->data, src1_q8.get(), (int) ne10,
+                                          (int) (ne11 * ne12), src1_padded_cols, stream);
+
+    ggml_sycl_pool_alloc<mmid_grouped_row> rows_dev(ctx.pool(), n_routed);
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(rows_dev.get(), rows.data(), n_routed * sizeof(mmid_grouped_row))));
+
+    const bool ok = ggml_sycl_mul_mat_vec_q_id_rows(
+        src0->type, src0->data, src1_q8.get(), rows_dev.get(), (int) n_routed,
+        (float *) dst->data, (int) ne10, (int) src0->ne[1],
+        /*expert_weight_stride=*/ src0->nb[2], /*src1_row_stride=*/ bytes_per_qrow,
+        /*dst_row_stride=*/ dst->nb[1], stream);
+    GGML_ASSERT(ok);
+    // the host-side vectors are consumed by the memcpy above; make sure the pool buffers outlive the launch
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+    return true;
+}
