+        if (sched->prefetch_slots[i] == NULL || sched->prefetch_slot_inflight[i]) { continue; }
+        if (ggml_backend_buffer_get_size(sched->prefetch_slots[i]) < need) { continue; }
+        if (best < 0 || sched->prefetch_slot_last[i] < sched->prefetch_slot_last[best]) { best = i; }
+    }
+    if (best >= 0) {
+        return best;
+    }
+    const char * env_margin = getenv("GGML_SCHED_PREFETCH_MIN_FREE_MB");
