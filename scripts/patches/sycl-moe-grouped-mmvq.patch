+// ---- GGML_SYCL_TIMELINE=<file> ---------------------------------------------------------------
+// Device timestamps of every staged upload chunk and every compute split, one block per graph.
+// Needs queues created with profiling (build with -DDPCT_PROFILING_ENABLED); events on queues
+// without it are skipped. Analyzed by scratchpad/timeline.py.
+struct ggml_sycl_timeline {
+    struct entry {
+        const char * queue;
+        const char * kind;
+        sycl::event  begin;   // for splits: the barrier before the split (its end = split start)
+        sycl::event  ev;
+        size_t       bytes;
+        std::string  label;
+    };
+    std::mutex         m;
+    std::vector<entry> entries;
+    FILE *             f       = nullptr;
+    int                graph   = 0;
+    bool               enabled = false;
+
+    ggml_sycl_timeline() {
+        const char * p = getenv("GGML_SYCL_TIMELINE");
+        if (p != nullptr) {
+            f = fopen(p, "w");
+            enabled = f != nullptr;
+        }
+    }
+    void add(const char * queue, const char * kind, const sycl::event & ev, size_t bytes, std::string label = "", const sycl::event * begin = nullptr) {
+        if (!enabled) { return; }
+        std::lock_guard<std::mutex> lock(m);
+        entries.push_back({ queue, kind, begin ? *begin : sycl::event(), ev, bytes, std::move(label) });
+    }
+    // after a full synchronize of the compute context: every recorded event is complete
+    void flush() {
+        if (!enabled) { return; }
+        std::lock_guard<std::mutex> lock(m);
+        if (entries.empty()) { return; }
+        fprintf(f, "graph %d\n", graph++);
+        for (auto & e : entries) {
+            try {
+                const uint64_t t1 = e.ev.get_profiling_info<sycl::info::event_profiling::command_end>();
+                uint64_t t0 = e.ev.get_profiling_info<sycl::info::event_profiling::command_start>();
+                if (e.kind[0] == 's') { // split: from the end of the barrier before it
+                    t0 = e.begin.get_profiling_info<sycl::info::event_profiling::command_end>();
+                }
+                fprintf(f, "%s %s %llu %llu %zu %s\n", e.queue, e.kind, (unsigned long long) t0, (unsigned long long) t1, e.bytes, e.label.c_str());
+            } catch (...) {
+                // queue without profiling
+            }
+        }
+        entries.clear();
+        fflush(f);
+    }
+};
+static ggml_sycl_timeline g_sycl_timeline;
+
+// ---- uploads from pageable host memory -------------------------------------------------------
+//
+// A Level Zero memcpy straight from pageable memory (the mmap'd model) runs far below link speed,
+// and that is exactly what the scheduler's per-micro-batch copies of the used experts hit. The
+// staging ring copies through pinned chunks: the host memcpy into one chunk overlaps the DMA of
+// the chunks before it. One ring per backend context, i.e. per queue, so that a ring never waits
+// for a DMA that sits behind another queue's kernels.
+struct ggml_sycl_staging_ring {
+    std::vector<char *>      buf;
+    std::vector<sycl::event> ev;
+    std::vector<bool>        used;
+    int                      next   = 0;
+    size_t                   chunk  = 0;
+    bool                     failed = false;
+    const char *             tag    = "cmp"; // timeline queue tag
+};
+
+// GGML_SYCL_OP_TIMING: time the rings spend waiting for DMAs vs copying into pinned memory
+struct ggml_sycl_staging_stats {
+    std::mutex m;
+    double t_wait = 0, t_memcpy = 0;
+    size_t bytes = 0;
+    double t_worker_busy = 0, t_event_block = 0; // upload thread busy time, host time blocked on its records
+    int    n_direct = 0; size_t direct_bytes = 0; // copies that bypassed the ring
+};
+static ggml_sycl_staging_stats g_sycl_staging_stats;
+
+static bool ggml_sycl_upload_pageable(queue_ptr stream, ggml_sycl_staging_ring & r, void * dst, const void * src, size_t size) {
+    static const bool disabled = getenv("GGML_SYCL_DISABLE_STAGED_UPLOAD") != nullptr;
+    // an isolated used expert is a copy of about 0.6 MiB, and the direct pageable path is slowest
+    // exactly there, so everything above a few KiB goes through the ring
+    static const size_t min_size = (size_t) (getenv("GGML_SYCL_STAGING_MIN_KB") ? atoi(getenv("GGML_SYCL_STAGING_MIN_KB")) : 16) << 10;
+    if (disabled || r.failed || size < min_size) {
+        return false;
+    }
+    if (sycl::get_pointer_type(src, stream->get_context()) != sycl::usm::alloc::unknown) {
+        return false; // already USM memory, the direct copy is the fast path
+    }
+    if (r.buf.empty()) {
+        const char * env_mb = getenv("GGML_SYCL_STAGING_CHUNK_MB");
+        const char * env_n  = getenv("GGML_SYCL_STAGING_CHUNKS");
+        r.chunk = (size_t) std::max(1, env_mb ? atoi(env_mb) : 8) << 20;
+        const int n = std::max(2, env_n ? atoi(env_n) : 8);
+        for (int i = 0; i < n; i++) {
+            char * p = (char *) sycl::malloc_host(r.chunk, *stream);
+            if (p == nullptr) {
+                r.failed = true;
+                break;
+            }
+            r.buf.push_back(p);
+        }
+        if (r.failed) {
+            for (char * p : r.buf) {
+                sycl::free(p, *stream);
+            }
+            r.buf.clear();
+            return false;
+        }
+        r.ev.resize(n);
+        r.used.assign(n, false);
+    }
+    const bool timing = ggml_sycl_op_timing_enabled();
+    double t_wait = 0, t_memcpy = 0;
+    const int n = (int) r.buf.size();
+    for (size_t off = 0; off < size; off += r.chunk) {
+        const int    i   = r.next;
+        const size_t len = std::min(r.chunk, size - off);
+        r.next = (r.next + 1) % n;
+        const auto t0 = timing ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point();
+        if (r.used[i]) {
+            r.ev[i].wait(); // the DMA that last read this chunk must be done before it is overwritten
+        }
+        const auto t1 = timing ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point();
+        memcpy(r.buf[i], (const char *) src + off, len);
+        r.ev[i]   = stream->memcpy((char *) dst + off, r.buf[i], len);
+        r.used[i] = true;
+        g_sycl_timeline.add(r.tag, "dma", r.ev[i], len);
+        if (timing) {
+            t_wait   += std::chrono::duration<double>(t1 - t0).count();
+            t_memcpy += std::chrono::duration<double>(std::chrono::steady_clock::now() - t1).count();
+        }
+    }
+    if (timing) {
+        std::lock_guard<std::mutex> lock(g_sycl_staging_stats.m);
+        g_sycl_staging_stats.t_wait   += t_wait;
+        g_sycl_staging_stats.t_memcpy += t_memcpy;
+        g_sycl_staging_stats.bytes    += size;
+    }
+    return true;
+}
