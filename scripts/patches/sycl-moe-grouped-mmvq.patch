+// Grouped variant of mul_mat_vec_q_moe: work-group dimension 1 walks an explicit list of
+// routed rows (expert, src1 row, dst row) instead of the expert slots of one token.
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void mul_mat_vec_q_moe_rows(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const mmid_grouped_row * __restrict__ rows,
+    const int ncols, const int nrows,
+    const size_t expert_weight_stride, const size_t src1_row_stride, const size_t dst_row_stride,
+    const sycl::nd_item<3> & item_ct1) {
+
+    const int r = item_ct1.get_group(1);
+    const mmid_grouped_row m = rows[r];
+
+    const char * vx = (const char *) vx_base + (size_t) m.expert * expert_weight_stride;
+    const char * vy = (const char *) vy_base + (size_t) m.src1_row * src1_row_stride;
+    float *      dst = (float *) ((char *) dst_base + (size_t) m.dst_row * dst_row_stride);
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) + item_ct1.get_local_id(1);
+
+    if (row >= nrows) {
+        return;
+    }
+
+    const int     blocks_per_row  = ncols / qk;
+    constexpr int blocks_per_warp = (vdr * WARP_SIZE + qi - 1) / qi;
+
+    float tmp = 0.0f;
+
+    const block_q_t *  x = (const block_q_t *) vx;
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+
+    for (int i = item_ct1.get_local_id(2) / (qi / vdr); i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i * (qk / QK8_1);
+
+        for (size_t elem = 0; elem < qi / vdr; elem += WARP_SIZE) {
+            const int iqs = elem + vdr * (item_ct1.get_local_id(2) % (qi / vdr));
+            tmp += vec_dot_q_sycl(&x[ibx], &y[iby], iqs);
+        }
+    }
+
+#pragma unroll
+    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        tmp += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp, mask);
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+        dst[row] = tmp;
+    }
+}
