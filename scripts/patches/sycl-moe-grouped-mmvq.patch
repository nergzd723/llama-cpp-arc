+// Multi-row MoE expert GEMV for batched mul_mat_id (prefill), no fp16 dequantize: every
+// quantized weight block is read once and dotted against up to 8 routed activation rows of
+// the same expert (Q8_1, contiguous, sorted by expert). groups_dev lists those row groups.
+// Returns false if src0_type isn't handled.
+#define MMID_NCOLS 8
+struct mmid_row_group {
+    int32_t expert; // index into the stacked expert weights
+    int32_t row0;   // first row in the contiguous Q8_1 activation buffer and in the contiguous dst
+    int32_t n;      // rows in this group, 1..8
+};
+bool ggml_sycl_mul_mat_vec_q_id_groups_supported(enum ggml_type src0_type);
+bool ggml_sycl_mul_mat_vec_q_id_groups(
+    enum ggml_type            src0_type,
+    const void *              vx_base,
+    const void *              vy_q8,           // contiguous Q8_1 rows, stride src1_row_stride bytes
+    const mmid_row_group *    groups_dev,
+    int                       n_groups,
+    float *                   dst_contig,      // row-major [rows x nrows] fp32
+    int                       ncols,
+    int                       nrows,
+    size_t                    expert_weight_stride,
+    size_t                    src1_row_stride,
+    dpct::queue_ptr           stream);
+
 // Reorder (SoA) variant of the fused MoE expert GEMV.
 // vx_base: each expert slice (stride expert_weight_stride == src0->nb[2]) is a self-contained reorder/SoA layout.
 // vy: src1 quantized with quantize_and_reorder_q8_1_soa (per-row SoA). Returns false if src0_type isn't handled.
