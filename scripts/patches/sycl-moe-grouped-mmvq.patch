+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_moe_ncols(
+    const void * vx_base, const void * vy_q8, const mmid_row_group * groups_dev, const int n_groups,
