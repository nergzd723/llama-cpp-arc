+    constexpr int blocks_per_warp = (vdr * WARP_SIZE + qi - 1) / qi;
+
+    float tmp[MMID_NCOLS];
+#pragma unroll
+    for (int c = 0; c < MMID_NCOLS; c++) {
+        tmp[c] = 0.0f;
+    }
+
+    const block_q_t * x = (const block_q_t *) vx;
+
+    for (int i = item_ct1.get_local_id(2) / (qi / vdr); i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i * (qk / QK8_1);
+
+        for (size_t elem = 0; elem < qi / vdr; elem += WARP_SIZE) {
+            const int iqs = elem + vdr * (item_ct1.get_local_id(2) % (qi / vdr));
+#pragma unroll
+            for (int c = 0; c < MMID_NCOLS; c++) {
+                if (c < grp.n) {
+                    const block_q8_1 * y = (const block_q8_1 *) (vy + (size_t) c * src1_row_stride);
+                    tmp[c] += vec_dot_q_sycl(&x[ibx], &y[iby], iqs);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int c = 0; c < MMID_NCOLS; c++) {
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[c] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[c], mask);
+        }
+        if (item_ct1.get_local_id(2) == 0 && c < grp.n) {
+            dst_base[(size_t) (grp.row0 + c) * nrows + row] = tmp[c];
+        }
+    }
+}
