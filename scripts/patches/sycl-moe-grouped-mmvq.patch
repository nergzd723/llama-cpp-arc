--- /dev/null
+++ b/ggml/src/ggml-sycl/moe-xmx.cpp
@@ -0,0 +1,151 @@
+#include "moe-xmx.hpp"
+#include "ggml.h"
+#include "dequantize.hpp"
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+using namespace sycl::ext::oneapi::experimental::matrix;
+
+static constexpr int TM  = MOE_XMX_TM;
+static constexpr int TN  = MOE_XMX_TN;
+static constexpr int TK  = 32;  // K elements decoded per step: one IQ4_NL block, one IQ2_S sub-block
+static constexpr int SGS = 16;  // sub-group size required by XMX
+static constexpr int NSG = TM / 8;
+
+// decode 32 consecutive elements [k0, k0+32) of one weight row into fp16
+template <typename block_t> struct moe_xmx_decoder;
+
+template <> struct moe_xmx_decoder<block_iq4_nl> {
+    static constexpr int K_BLOCK = QK4_NL;
+    static __dpct_inline__ void decode32(const block_iq4_nl * row_blocks, int k0, sycl::half * out) {
+        const block_iq4_nl & b = row_blocks[k0 / QK4_NL];
+        const float d = (float) b.d;
+#pragma unroll
+        for (int j = 0; j < 16; j++) {
+            out[j]      = (sycl::half) (d * kvalues_iq4nl[b.qs[j] & 0xf]);
+            out[j + 16] = (sycl::half) (d * kvalues_iq4nl[b.qs[j] >> 4]);
+        }
+    }
+};
+
+template <> struct moe_xmx_decoder<block_iq2_s> {
+    static constexpr int K_BLOCK = QK_K;
+    static __dpct_inline__ void decode32(const block_iq2_s * row_blocks, int k0, sycl::half * out) {
+        const block_iq2_s & b = row_blocks[k0 / QK_K];
+        const int ib = (k0 % QK_K) / 32;
+        const float d = (float) b.d;
+        const uint8_t sc = b.scales[ib];
+#pragma unroll
+        for (int il = 0; il < 4; il++) {
+            const uint8_t * g = (const uint8_t *) (iq2s_grid + (b.qs[4*ib + il] | ((b.qh[ib] << (8 - 2*il)) & 0x300)));
+            const float dl = d * (0.5f + ((sc >> (4 * (il / 2))) & 0xf)) * 0.25f;
+            const uint8_t signs = b.qs[QK_K/8 + 4*ib + il];
+#pragma unroll
+            for (int j = 0; j < 8; j++) {
+                out[8*il + j] = (sycl::half) (dl * g[j] * ((signs & kmask_iq2xs[j]) ? -1.f : 1.f));
+            }
+        }
+    }
+};
+
+template <> struct moe_xmx_decoder<block_iq3_s> {
+    static constexpr int K_BLOCK = QK_K;
+    static __dpct_inline__ void decode32(const block_iq3_s * row_blocks, int k0, sycl::half * out) {
+        const block_iq3_s & b = row_blocks[k0 / QK_K];
+        const int ib = (k0 % QK_K) / 32;
+        const float d = (float) b.d * (1 + 2 * ((b.scales[ib/2] >> (4 * (ib % 2))) & 0xf));
+        const uint8_t * qs = b.qs + 8*ib;
+#pragma unroll
+        for (int il = 0; il < 4; il++) {
+            const uint8_t * g1 = (const uint8_t *) (iq3s_grid + (qs[2*il + 0] | ((b.qh[ib] << (8 - 2*il)) & 256)));
+            const uint8_t * g2 = (const uint8_t *) (iq3s_grid + (qs[2*il + 1] | ((b.qh[ib] << (7 - 2*il)) & 256)));
+            const uint8_t signs = b.signs[4*ib + il];
+#pragma unroll
+            for (int j = 0; j < 4; j++) {
+                out[8*il + j]     = (sycl::half) (d * g1[j] * ((signs & kmask_iq2xs[j])     ? -1.f : 1.f));
+                out[8*il + 4 + j] = (sycl::half) (d * g2[j] * ((signs & kmask_iq2xs[j + 4]) ? -1.f : 1.f));
+            }
+        }
+    }
+};
+
+template <typename block_t>
+static void moe_xmx_launch(const void * vx_base, size_t expert_stride_bytes, const sycl::half * A, float * C,
+                           const moe_xmx_tile * tiles, int n_tiles, int64_t M, int64_t K, dpct::queue_ptr stream) {
+    const int n_tiles_n     = (int) (M / TN);
+    const int blocks_per_row = (int) (K / moe_xmx_decoder<block_t>::K_BLOCK);
+    const int Ki = (int) K, Mi = (int) M;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<sycl::half, 1> Bs(TN * TK, h); // packed: (TK/2) rows of TN*2 halves
+        h.parallel_for(sycl::nd_range<2>(sycl::range<2>(n_tiles, (size_t) n_tiles_n * NSG * SGS), sycl::range<2>(1, NSG * SGS)),
+            [=](sycl::nd_item<2> it) [[sycl::reqd_sub_group_size(SGS)]] {
+                const moe_xmx_tile td = tiles[it.get_group(0)];
+                const int tn   = it.get_group(1);
+                const int lid  = it.get_local_id(1);
+                const int sgid = lid / SGS;
+                sycl::sub_group sg = it.get_sub_group();
+
+                const block_t *    Wexp = (const block_t *) ((const char *) vx_base + (size_t) td.expert * expert_stride_bytes);
+                const sycl::half * Arow = A + (size_t) (td.row0 + sgid * 8) * Ki;
+
+                joint_matrix<sycl::sub_group, float, use::accumulator, 8, 16> acc[TN / 16];
+#pragma unroll
+                for (int j = 0; j < TN / 16; j++) {
+                    joint_matrix_fill(sg, acc[j], 0.0f);
+                }
+
+                sycl::half * bs = Bs.get_multi_ptr<sycl::access::decorated::no>().get();
+                const block_t * row_blocks = Wexp + (size_t) (tn * TN + lid) * blocks_per_row;
+                for (int k0 = 0; k0 < Ki; k0 += TK) {
+                    {
+                        sycl::half vals[TK];
+                        moe_xmx_decoder<block_t>::decode32(row_blocks, k0, vals);
+#pragma unroll
+                        for (int k = 0; k < TK; k++) {
+                            bs[(k / 2) * (TN * 2) + lid * 2 + (k % 2)] = vals[k];
+                        }
+                    }
+                    it.barrier(sycl::access::fence_space::local_space);
+#pragma unroll
+                    for (int s = 0; s < TK / 16; s++) {
+                        joint_matrix<sycl::sub_group, sycl::half, use::a, 8, 16, layout::row_major> a;
+                        joint_matrix_load(sg, a, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(Arow + k0 + 16 * s), Ki);
+#pragma unroll
+                        for (int j = 0; j < TN / 16; j++) {
+                            joint_matrix<sycl::sub_group, sycl::half, use::b, 16, 16, layout::ext_intel_packed> b;
+                            joint_matrix_load(sg, b, Bs.get_multi_ptr<sycl::access::decorated::no>() + (8 * s) * (TN * 2) + (16 * j) * 2, TN * 2);
+                            joint_matrix_mad(sg, acc[j], a, b, acc[j]);
+                        }
+                    }
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+                float * Crow = C + (size_t) (td.row0 + sgid * 8) * Mi + tn * TN;
+#pragma unroll
+                for (int j = 0; j < TN / 16; j++) {
+                    joint_matrix_store(sg, acc[j], sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(Crow + 16 * j), Mi, layout::row_major);
+                }
+            });
+    });
+}
+
+bool ggml_sycl_moe_xmx_supported(enum ggml_type src0_type, int64_t M, int64_t K) {
+    if (M % TN != 0 || K % TK != 0) {
+        return false;
+    }
+    switch (src0_type) {
+        case GGML_TYPE_IQ2_S:  return K % QK_K == 0;
+        case GGML_TYPE_IQ3_S:  return K % QK_K == 0;
+        case GGML_TYPE_IQ4_NL: return true;
+        default:               return false;
+    }
+}
+
+void ggml_sycl_moe_xmx(enum ggml_type src0_type, const void * vx_base, size_t expert_stride_bytes,
+                       const sycl::half * A, float * C, const moe_xmx_tile * tiles, int n_tiles,
+                       int64_t M, int64_t K, dpct::queue_ptr stream) {
+    switch (src0_type) {
+        case GGML_TYPE_IQ2_S:  moe_xmx_launch<block_iq2_s>(vx_base, expert_stride_bytes, A, C, tiles, n_tiles, M, K, stream); break;
+        case GGML_TYPE_IQ3_S:  moe_xmx_launch<block_iq3_s>(vx_base, expert_stride_bytes, A, C, tiles, n_tiles, M, K, stream); break;
+        case GGML_TYPE_IQ4_NL: moe_xmx_launch<block_iq4_nl>(vx_base, expert_stride_bytes, A, C, tiles, n_tiles, M, K, stream); break;
+        default: GGML_ABORT("moe_xmx: unsupported type");
+    }
+}
