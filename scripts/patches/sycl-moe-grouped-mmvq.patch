+// Upload from pageable host memory (the mmap'd model) through a pinned, double-buffered
+// staging ring so that the host memcpy into pinned memory overlaps the DMA into device
+// memory. A Level Zero memcpy straight from pageable memory runs far below link speed, and
+// that is exactly what the scheduler's per-micro-batch copies of the used experts hit.
+struct ggml_sycl_staging_ring {
+    std::mutex   mutex;
+    char *       buf[2]  = { nullptr, nullptr };
+    sycl::event  ev[2];
+    bool         used[2] = { false, false };
+    int          next    = 0;
+    size_t       chunk   = 0;
+};
+
+static bool ggml_sycl_upload_pageable(queue_ptr stream, int device, void * dst, const void * src, size_t size) {
+    static const bool enabled = getenv("GGML_SYCL_STAGED_UPLOAD") != nullptr;
+    if (!enabled || size < ((size_t) 1 << 20)) {
+        return false; // no measurable gain on a B580 over PCIe Gen 3 x8; opt-in
+    }
+    if (sycl::get_pointer_type(src, stream->get_context()) != sycl::usm::alloc::unknown) {
+        return false; // already USM memory, the direct copy is the fast path
+    }
+    static ggml_sycl_staging_ring rings[GGML_SYCL_MAX_DEVICES];
+    ggml_sycl_staging_ring & r = rings[device];
+    std::lock_guard<std::mutex> lock(r.mutex);
+    if (r.buf[0] == nullptr) {
+        const char * env = getenv("GGML_SYCL_STAGING_CHUNK_MB");
+        r.chunk = (size_t) (env ? atoi(env) : 32) << 20;
+        for (int i = 0; i < 2; i++) {
+            r.buf[i] = (char *) sycl::malloc_host(r.chunk, *stream);
+            if (r.buf[i] == nullptr) {
+                r.chunk = 0;
+                return false;
+            }
+        }
+    }
+    for (size_t off = 0; off < size; off += r.chunk) {
+        const int    i = r.next;
+        const size_t n = std::min(r.chunk, size - off);
+        r.next ^= 1;
+        if (r.used[i]) {
+            r.ev[i].wait(); // the DMA that last read this staging buffer must be done before we overwrite it
+        }
+        memcpy(r.buf[i], (const char *) src + off, n);
+        r.ev[i]   = stream->memcpy((char *) dst + off, r.buf[i], n);
+        r.used[i] = true;
+    }
+    return true;
+}
