+        if (sched->prefetch_slots[i] != NULL) { continue; }
+        if (dev_total > 0 && dev_free < need + margin) { break; }
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, need);
+        if (buf == NULL) { break; }
+        sched->prefetch_slots[i] = buf;
