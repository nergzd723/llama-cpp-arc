+// Bucketed batched GEMM for mul_mat_id (prefill). Experts are grouped by how many routed
+// rows they own, rounded up to a power of two; each expert's rows are gathered (already in
+// fp16) into a slot of that size, so every bucket is one uniform pointer-array batched GEMM.
+// A contiguous chunk of experts is dequantized to fp16 in one launch. Per weight tensor this
+// is a few dozen launches instead of one dequantize + one GEMM + one sync per expert.
+// ids may contain -1 (hot/cold expert split): those rows are skipped and their dst rows zeroed.
+__dpct_inline__ static void k_moe_gather_rows_f16(
+    const char * __restrict__ src1, sycl::half * __restrict__ dst_pad,
+    const mmid_row_mapping * __restrict__ rows, const int32_t * __restrict__ pad_row,
+    int64_t ne11, int64_t K, size_t nb11, size_t nb12, const sycl::nd_item<3> & item_ct1) {
+    const int32_t r  = item_ct1.get_group(2);
+    const int32_t i1 = rows[r].i1;
+    const int32_t i2 = rows[r].i2;
+    const float * src = (const float *) (src1 + (i1 % ne11) * nb11 + i2 * nb12);
+    sycl::half *  dst = dst_pad + (size_t) pad_row[r] * K;
+    for (int64_t i = item_ct1.get_local_id(2); i < K; i += item_ct1.get_local_range(2)) {
+        dst[i] = (sycl::half) src[i];
+    }
+}
+
+__dpct_inline__ static void k_moe_scatter_rows_pad(
+    char * __restrict__ dst, const float * __restrict__ c_pad,
+    const mmid_row_mapping * __restrict__ rows, const int32_t * __restrict__ pad_row,
+    int64_t M, size_t nb1, size_t nb2, const sycl::nd_item<3> & item_ct1) {
+    const int32_t r   = item_ct1.get_group(2);
+    float *       out = (float *) (dst + rows[r].i1 * nb1 + rows[r].i2 * nb2);
+    const float * src = c_pad + (size_t) pad_row[r] * M;
+    for (int64_t i = item_ct1.get_local_id(2); i < M; i += item_ct1.get_local_range(2)) {
+        out[i] = src[i];
+    }
+}
+
+static bool ggml_sycl_mul_mat_id_bucketed_gemm(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                                               const ggml_tensor * src1, const ggml_tensor * ids,
+                                               ggml_tensor * dst, const char * ids_host) {
+    if (!getenv("GGML_SYCL_MOE_BUCKETED_GEMM")) {
+        return false; // measured slower than the per-expert loop on a B580 (79 vs 130 tok/s); kept for comparison
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src1) || !ggml_is_contiguous(dst) || !ggml_is_contiguous(src0) || ids->nb[0] != sizeof(int32_t)) {
+        return false;
+    }
+    const ggml_tensor_extra_gpu * src0_extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (src0_extra && src0_extra->optimized_feature.reorder) {
+        return false;
+    }
+    switch (src0->type) { // types with an fp16 dequantizer
+        case GGML_TYPE_Q4_0: case GGML_TYPE_Q4_1: case GGML_TYPE_Q5_0: case GGML_TYPE_Q5_1: case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ2_XXS: case GGML_TYPE_IQ2_XS: case GGML_TYPE_IQ2_S: case GGML_TYPE_IQ3_XXS: case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ4_NL: case GGML_TYPE_IQ4_XS:
+            break;
+        default:
+            return false;
+    }
+    const int64_t K = src0->ne[0], M = src0->ne[1], n_as = src0->ne[2];
+    const int64_t n_ids = ids->ne[0], n_tokens = ids->ne[1];
+    const int64_t ne11 = src1->ne[1], ne12 = src1->ne[2];
+    if (src1->ne[0] != K || ne12 != n_tokens || (ne11 != 1 && ne11 != n_ids) || dst->ne[0] != M ||
+        dst->ne[1] != n_ids || dst->ne[2] != n_tokens || src0->nb[2] != (size_t) M * src0->nb[1]) {
+        return false;
+    }
+    const to_fp16_sycl_t to_fp16_w = ggml_get_to_fp16_sycl(src0->type, dst);
+    if (to_fp16_w == nullptr) {
+        return false;
+    }
+
+    const queue_ptr stream = ctx.stream();
+
+    std::vector<int64_t> counts, offsets;
+    std::vector<mmid_row_mapping> & routed = ctx.mmid_row_mapping_host;
+    const int64_t n_total = n_tokens * n_ids;
+    const int64_t n_used  = mmid_counting_sort_rows(ids, ids_host, n_ids, n_as, n_total, counts, offsets, routed);
+    if (n_used < n_total) {
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memset(dst->data, 0, ggml_nbytes(dst))));
+    }
+    if (n_used == 0) {
+        return true;
+    }
+
+    // buckets by rows per expert: 16, 32, ..., 2048
+    constexpr int     n_buckets = 8;
+    constexpr int64_t bucket_min = 16, bucket_max = 2048;
+    std::vector<int>     bucket_of(n_as, -1);
+    std::vector<int64_t> pad_base(n_as, 0);
+    std::vector<int64_t> slots(n_buckets, 0);
+    for (int64_t e = 0; e < n_as; e++) {
+        if (counts[e] == 0) {
+            continue;
+        }
+        if (counts[e] > bucket_max) {
+            return false;
+        }
+        int b = 0;
+        while ((bucket_min << b) < counts[e]) {
+            b++;
+        }
+        bucket_of[e] = b;
+        slots[b]++;
+    }
+    std::vector<int64_t> bucket_base(n_buckets + 1, 0);
+    for (int b = 0; b < n_buckets; b++) {
+        bucket_base[b + 1] = bucket_base[b] + slots[b] * (bucket_min << b);
+    }
+    const int64_t n_pad = bucket_base[n_buckets];
+    // memory: padded fp16 activations + padded fp32 results + one dequantized chunk
+    const size_t chunk_bytes_max = (size_t) 128 << 20;
+    if ((size_t) n_pad * (K * sizeof(sycl::half) + M * sizeof(float)) > ((size_t) 900 << 20)) {
+        return false;
+    }
+    std::vector<int64_t> next_slot(n_buckets, 0);
+    std::vector<int32_t> pad_row(n_used);
+    for (int64_t e = 0; e < n_as; e++) {
+        if (counts[e] == 0) {
+            continue;
+        }
+        const int b = bucket_of[e];
+        pad_base[e] = bucket_base[b] + (next_slot[b]++) * (bucket_min << b);
+        for (int64_t r = 0; r < counts[e]; r++) {
+            pad_row[offsets[e] + r] = (int32_t) (pad_base[e] + r);
+        }
+    }
+
+    ggml_sycl_pool_alloc<mmid_row_mapping> dev_rows(ctx.pool(), n_used);
+    ggml_sycl_pool_alloc<int32_t>          dev_pad_row(ctx.pool(), n_used);
+    ggml_sycl_pool_alloc<sycl::half>       b_pad(ctx.pool(), (size_t) n_pad * K);
+    ggml_sycl_pool_alloc<float>            c_pad(ctx.pool(), (size_t) n_pad * M);
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(dev_rows.get(), routed.data(), n_used * sizeof(mmid_row_mapping))));
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(dev_pad_row.get(), pad_row.data(), n_used * sizeof(int32_t))));
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memset(b_pad.get(), 0, (size_t) n_pad * K * sizeof(sycl::half))));
+
+    const unsigned int max_wg = ggml_sycl_info().max_work_group_sizes[ctx.device];
+    {
+        const char * src1_p = (const char *) src1->data;
+        sycl::half * b_pad_p = b_pad.get();
+        const mmid_row_mapping * rows_p = dev_rows.get();
+        const int32_t * pad_row_p = dev_pad_row.get();
+        const size_t nb11 = src1->nb[1], nb12 = src1->nb[2];
+        sycl::range<3> block_dims(1, 1, std::min((unsigned int) K, max_wg));
+        sycl::range<3> grid_dims(1, 1, (size_t) n_used);
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(sycl::nd_range<3>(grid_dims * block_dims, block_dims), [=](sycl::nd_item<3> item_ct1) {
+                k_moe_gather_rows_f16(src1_p, b_pad_p, rows_p, pad_row_p, ne11, K, nb11, nb12, item_ct1);
+            });
+        });
+    }
+
+    // pointer tables for every (chunk, bucket) batched GEMM, uploaded once
+    const size_t  expert_bytes_f16 = (size_t) M * K * sizeof(sycl::half);
+    const int64_t per_chunk = std::max<int64_t>(1, std::min<int64_t>(n_as, chunk_bytes_max / expert_bytes_f16));
+    ggml_sycl_pool_alloc<sycl::half> w_f16(ctx.pool(), (size_t) per_chunk * M * K);
+    struct batch_desc { int64_t first; int64_t count; int bucket; int64_t chunk; };
+    std::vector<batch_desc>   batches;
+    std::vector<const void *> h_ptrs; // [a...][b...][c...] per batch, laid out batch by batch
+    for (int64_t e0 = 0; e0 < n_as; e0 += per_chunk) {
+        const int64_t e1 = std::min(n_as, e0 + per_chunk);
+        for (int b = 0; b < n_buckets; b++) {
+            batch_desc d = { (int64_t) h_ptrs.size(), 0, b, e0 };
+            std::vector<const void *> pa, pb, pc;
+            for (int64_t e = e0; e < e1; e++) {
+                if (counts[e] == 0 || bucket_of[e] != b) {
+                    continue;
+                }
+                pa.push_back(w_f16.get() + (size_t) (e - e0) * M * K);
+                pb.push_back(b_pad.get() + (size_t) pad_base[e] * K);
+                pc.push_back(c_pad.get() + (size_t) pad_base[e] * M);
+            }
+            if (pa.empty()) {
+                continue;
+            }
+            d.count = (int64_t) pa.size();
+            h_ptrs.insert(h_ptrs.end(), pa.begin(), pa.end());
+            h_ptrs.insert(h_ptrs.end(), pb.begin(), pb.end());
+            h_ptrs.insert(h_ptrs.end(), pc.begin(), pc.end());
+            batches.push_back(d);
+        }
+    }
+    ggml_sycl_pool_alloc<const void *> d_ptrs(ctx.pool(), h_ptrs.size());
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(d_ptrs.get(), h_ptrs.data(), h_ptrs.size() * sizeof(void *))));
+    ggml_sycl_pool_alloc<matrix_info_t<float>> matrix_info(ctx.host_pool(), std::max<size_t>(1, batches.size()));
+
+    const float alpha = 1.0f, beta = 0.0f;
+    size_t bi = 0;
+    for (int64_t e0 = 0; e0 < n_as; e0 += per_chunk) {
+        const int64_t e1 = std::min(n_as, e0 + per_chunk);
+        bool any = false;
+        for (int64_t e = e0; e < e1 && !any; e++) {
+            any = counts[e] > 0;
+        }
+        if (!any) {
+            continue;
+        }
+        to_fp16_w((const char *) src0->data + e0 * src0->nb[2], w_f16.get(), (e1 - e0) * M * K, stream);
+        for (int b = 0; b < n_buckets; b++) {
+            if (bi >= batches.size() || batches[bi].chunk != e0 || batches[bi].bucket != b) {
+                continue;
+            }
+            // batches were pushed in (chunk, bucket) order; consume the ones of this chunk
+            const batch_desc & d = batches[bi];
+            const int64_t N = bucket_min << b;
+            const void ** a = d_ptrs.get() + d.first;
+            const void ** bp = a + d.count;
+            void **       c = (void **) (bp + d.count);
+            SYCL_CHECK(CHECK_TRY_ERROR(dpct::gemm_batch(
+                *stream, oneapi::mkl::transpose::trans, oneapi::mkl::transpose::nontrans, M, N, K, &alpha,
+                a, dpct::library_data_t::real_half, K, bp, dpct::library_data_t::real_half, K, &beta,
+                c, dpct::library_data_t::real_float, M, (int) d.count, dpct::library_data_t::real_float,
+                matrix_info.get() + bi)));
+            bi++;
+        }
+    }
+    GGML_ASSERT(bi == batches.size());
+
+    {
+        char * dst_p = (char *) dst->data;
+        const float * c_pad_p = c_pad.get();
+        const mmid_row_mapping * rows_p = dev_rows.get();
+        const int32_t * pad_row_p = dev_pad_row.get();
+        const size_t nb1 = dst->nb[1], nb2 = dst->nb[2];
+        sycl::range<3> block_dims(1, 1, std::min((unsigned int) M, max_wg));
+        sycl::range<3> grid_dims(1, 1, (size_t) n_used);
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(sycl::nd_range<3>(grid_dims * block_dims, block_dims), [=](sycl::nd_item<3> item_ct1) {
+                k_moe_scatter_rows_pad(dst_p, c_pad_p, rows_p, pad_row_p, M, nb1, nb2, item_ct1);
+            });
+        });
+    }
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+    return true;
+}
+
+// Grouped GEMM for batched mul_mat_id (prefill): the per-expert loop below costs one
+// dequantize launch, one GEMM launch and a sync per expert, about 67k of each per 2048-token
+// micro-batch on Qwen3.8's 512 experts. Here a contiguous chunk of experts is dequantized to
+// fp16 in one launch and multiplied with oneMKL's group gemm_batch in one call, with the same
+// fp16-in / fp32-accumulate arithmetic as the per-expert path. ids may contain -1 (hot/cold
+// expert split): those rows are skipped and their dst rows zeroed.
+static bool ggml_sycl_mul_mat_id_grouped_gemm(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                                              const ggml_tensor * src1, const ggml_tensor * ids,
+                                              ggml_tensor * dst, const char * ids_host) {
+    if (!getenv("GGML_SYCL_MOE_GROUPED_GEMM")) {
+        return false; // measured slower than the per-expert loop; kept for comparison
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || src0->type == GGML_TYPE_F32) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src1) || !ggml_is_contiguous(dst) || ids->nb[0] != sizeof(int32_t)) {
+        return false;
+    }
+    const ggml_tensor_extra_gpu * src0_extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (src0_extra && src0_extra->optimized_feature.reorder) {
+        return false;
+    }
+    switch (src0->type) { // types with an fp16 dequantizer (the lookup below aborts on others)
+        case GGML_TYPE_Q4_0: case GGML_TYPE_Q4_1: case GGML_TYPE_Q5_0: case GGML_TYPE_Q5_1: case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ2_XXS: case GGML_TYPE_IQ2_XS: case GGML_TYPE_IQ2_S: case GGML_TYPE_IQ3_XXS: case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ4_NL: case GGML_TYPE_IQ4_XS:
+            break;
+        default:
+            return false;
+    }
+    const to_fp16_sycl_t to_fp16_w = ggml_get_to_fp16_sycl(src0->type, dst);
+    const to_fp16_sycl_t to_fp16_a = ggml_get_to_fp16_sycl(GGML_TYPE_F32, dst);
+    if (to_fp16_w == nullptr || to_fp16_a == nullptr) {
