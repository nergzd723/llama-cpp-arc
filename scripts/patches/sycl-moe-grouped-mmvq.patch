+// the upload thread exists only for contexts with their own queue (the scheduler's prefetch
+// backend); the compute context keeps its uploads on the calling thread
+static ggml_sycl_upload_worker * ggml_sycl_ctx_worker(ggml_backend_sycl_context * ctx) {
+    static const bool enabled = [] { const char * e = getenv("GGML_SYCL_UPLOAD_WORKER"); return e == nullptr || atoi(e) != 0; }();
+    if (!enabled || !ctx->own_queue) {
+        return nullptr;
+    }
+    if (ctx->worker == nullptr) {
+        const char * e = getenv("GGML_SYCL_UPLOAD_THREADS");
+        ctx->worker = new ggml_sycl_upload_worker(ctx->stream(ctx->device, 0), std::max(1, e ? atoi(e) : 3), ctx->instance == 1 ? "pre" : "fix");
+    }
+    return ctx->worker;
+}
+
+static void ggml_sycl_ctx_free_uploads(ggml_backend_sycl_context * ctx) {
+    delete ctx->worker; // drains, then joins
+    ctx->worker = nullptr;
+    for (auto & hb : ctx->mmid_host) {
+        if (hb.p != nullptr) {
+            if (hb.used) { hb.ev.wait(); }
+            sycl::free(hb.p, *ctx->stream(ctx->device, 0));
+            hb.p = nullptr;
+        }
+    }
+    if (ctx->staging != nullptr) {
+        ggml_sycl_staging_ring_free(ctx->staging, ctx->stream(ctx->device, 0));
+        ctx->staging = nullptr;
+    }
+}
