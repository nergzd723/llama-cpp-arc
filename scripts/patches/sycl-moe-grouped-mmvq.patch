+// Multi-row variant of mul_mat_vec_q_moe: work-group dimension 1 walks groups of up to
+// MMID_NCOLS routed rows of one expert; each quantized weight block is loaded once and dotted
+// against every row of the group, so weight traffic drops by the group size and no fp16 copy
+// of the experts is ever made.
+
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void mul_mat_vec_q_moe_ncols(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const mmid_row_group * __restrict__ groups,
+    const int ncols, const int nrows,
+    const size_t expert_weight_stride, const size_t src1_row_stride,
+    const sycl::nd_item<3> & item_ct1) {
+
+    const int g = item_ct1.get_group(1);
+    const mmid_row_group grp = groups[g];
+
+    const char * vx = (const char *) vx_base + (size_t) grp.expert * expert_weight_stride;
+    const char * vy = (const char *) vy_base + (size_t) grp.row0 * src1_row_stride;
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) + item_ct1.get_local_id(1);
+
+    if (row >= nrows) {
+        return;
+    }
+
+    const int     blocks_per_row  = ncols / qk;
+    constexpr int blocks_per_warp = (vdr * WARP_SIZE + qi - 1) / qi;
+
+    float tmp[MMID_NCOLS];
+#pragma unroll
+    for (int c = 0; c < MMID_NCOLS; c++) {
+        tmp[c] = 0.0f;
+    }
+
+    const block_q_t * x = (const block_q_t *) vx;
+
+    for (int i = item_ct1.get_local_id(2) / (qi / vdr); i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i * (qk / QK8_1);
+
+        for (size_t elem = 0; elem < qi / vdr; elem += WARP_SIZE) {
+            const int iqs = elem + vdr * (item_ct1.get_local_id(2) % (qi / vdr));
+#pragma unroll
+            for (int c = 0; c < MMID_NCOLS; c++) {
+                if (c < grp.n) {
+                    const block_q8_1 * y = (const block_q8_1 *) (vy + (size_t) c * src1_row_stride);
+                    tmp[c] += vec_dot_q_sycl(&x[ibx], &y[iby], iqs);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int c = 0; c < MMID_NCOLS; c++) {
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[c] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[c], mask);
+        }
+        if (item_ct1.get_local_id(2) == 0 && c < grp.n) {
+            dst_base[(size_t) (grp.row0 + c) * nrows + row] = tmp[c];
+        }
+    }
+}
+
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_moe_ncols(
+    const void * vx_base, const void * vy_q8, const mmid_row_group * groups_dev, const int n_groups,
+    float * dst_contig, const int ncols, const int nrows,
+    const size_t expert_weight_stride, const size_t src1_row_stride,
+    dpct::queue_ptr stream) {
+    const int            block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums(1, (unsigned) n_groups, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_ncols<qk, qi, block_q_t, vdr, vec_dot_q_sycl>(
+                    vx_base, vy_q8, dst_contig, groups_dev, ncols, nrows,
+                    expert_weight_stride, src1_row_stride, item);
+            });
+    });
+}
