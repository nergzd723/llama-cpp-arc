+// a backend event: the sycl::event plus a "pending" state for events recorded through an upload
+// worker, which become valid only once the worker reaches the record request
+struct ggml_sycl_event_state {
+    sycl::event             ev;
+    std::mutex              m;
+    std::condition_variable cv;
+    bool                    pending = false;
+
+    void set_pending() {
+        std::lock_guard<std::mutex> lock(m);
+        pending = true;
+    }
+    void set(const sycl::event & e) {
+        {
+            std::lock_guard<std::mutex> lock(m);
+            ev = e;
+            pending = false;
+        }
+        cv.notify_all();
+    }
+    sycl::event get() {
+        std::unique_lock<std::mutex> lock(m);
+        cv.wait(lock, [&] { return !pending; });
+        return ev;
+    }
+};
+
+// The scheduler's prefetch backend hands its host->device copies, event records and event waits
+// to these threads, so the main thread never blocks in a staging ring's memcpy loop while it could
+// be launching kernels. Copies run concurrently on GGML_SYCL_UPLOAD_THREADS threads (default 3),
+// each with its own pinned ring: the memcpy out of the mmap'd model, with its page faults, is
+// slower per thread than the link. Event records and waits are ordering points: one is executed
+// only once every copy pushed before it has been launched, and nothing pushed after it starts
+// before it ran. ggml_backend_sycl_synchronize and get_tensor drain the queue first.
+struct ggml_sycl_upload_worker {
+    enum kind { COPY, RECORD, WAIT };
+    struct req {
+        kind                    k;
+        void *                  dst;
+        const void *            src;
+        size_t                  size;
+        ggml_sycl_event_state * ev;
+    };
+
+    queue_ptr                             stream;
+    std::vector<ggml_sycl_staging_ring *> rings;
+    std::vector<std::thread>              threads;
+    std::mutex                            m;
+    std::condition_variable               cv, cv_idle, cv_inflight;
+    std::deque<req>                       q;
+    int                                   inflight = 0; // copies popped but not yet launched
+    bool                                  stop = false;
+
+    ggml_sycl_upload_worker(queue_ptr stream, int n_threads, const char * tag) : stream(stream) {
+        for (int i = 0; i < n_threads; i++) {
+            rings.push_back(new ggml_sycl_staging_ring());
+            rings.back()->tag = tag;
+        }
+        for (int i = 0; i < n_threads; i++) {
+            threads.emplace_back([this, i] { run(rings[i]); });
+        }
+    }
+    ~ggml_sycl_upload_worker() {
+        {
+            std::lock_guard<std::mutex> lock(m);
+            stop = true;
+        }
+        cv.notify_all();
+        for (auto & t : threads) {
+            t.join();
+        }
+        for (auto * r : rings) {
+            ggml_sycl_staging_ring_free(r, stream);
+        }
+    }
+    void push(const req & r) {
+        {
+            std::lock_guard<std::mutex> lock(m);
+            q.push_back(r);
+        }
+        cv.notify_all();
+    }
+    void drain() {
+        std::unique_lock<std::mutex> lock(m);
+        cv_idle.wait(lock, [&] { return q.empty() && inflight == 0; });
+    }
+    void run(ggml_sycl_staging_ring * ring) try {
+        for (;;) {
+            req r;
+            {
+                std::unique_lock<std::mutex> lock(m);
+                cv.wait(lock, [&] { return stop || !q.empty(); });
+                if (q.empty()) {
+                    return; // stop requested and nothing left to run
+                }
+                if (q.front().k != COPY) {
+                    // ordering point: every copy pushed before it must have been launched
+                    cv_inflight.wait(lock, [&] { return inflight == 0 || stop; });
+                    if (q.empty() || q.front().k == COPY) {
+                        continue; // another thread took it
+                    }
+                    r = q.front();
+                    q.pop_front();
+                    if (r.k == RECORD) {
+                        r.ev->set(stream->ext_oneapi_submit_barrier());
+                    } else {
+                        const sycl::event e = r.ev->get();
+                        SYCL_CHECK(CHECK_TRY_ERROR(stream->ext_oneapi_submit_barrier({ e })));
+                    }
+                    if (q.empty()) {
+                        cv_idle.notify_all();
+                    }
+                    cv.notify_all();
+                    continue;
+                }
+                r = q.front();
+                q.pop_front();
+                inflight++;
+            }
+            const bool timing = ggml_sycl_op_timing_enabled();
+            const auto t0 = timing ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point();
+            if (!ggml_sycl_upload_pageable(stream, *ring, r.dst, r.src, r.size)) {
+                SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(r.dst, r.src, r.size)));
+                if (timing) { std::lock_guard<std::mutex> lock(g_sycl_staging_stats.m); g_sycl_staging_stats.n_direct++; g_sycl_staging_stats.direct_bytes += r.size; }
+            }
+            if (timing) {
+                std::lock_guard<std::mutex> lock(g_sycl_staging_stats.m);
+                g_sycl_staging_stats.t_worker_busy += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+            }
+            {
+                std::lock_guard<std::mutex> lock(m);
+                inflight--;
+                if (inflight == 0) {
+                    cv_inflight.notify_all();
+                    if (q.empty()) {
+                        cv_idle.notify_all();
+                    }
+                }
+            }
+        }
+    } catch (sycl::exception const & exc) {
+        std::cerr << exc.what() << "Exception caught at file:" << __FILE__ << ", line:" << __LINE__ << std::endl;
+        std::exit(1);
+    }
+};
