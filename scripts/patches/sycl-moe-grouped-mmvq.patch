+                expert_weight_stride, src1_row_stride, dst_row_stride, stream);
+            return true;
+        case GGML_TYPE_IQ2_S:
+            launch_mul_mat_vec_q_moe_rows<QK_K, QI2_S/2, block_iq2_s, 1, vec_dot_iq2_s_q8_1>(
