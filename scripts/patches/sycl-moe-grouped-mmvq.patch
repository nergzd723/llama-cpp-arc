+static void ggml_sycl_staging_ring_free(ggml_sycl_staging_ring * r, queue_ptr stream) {
+    if (r == nullptr) {
+        return;
+    }
+    for (size_t i = 0; i < r->buf.size(); i++) {
+        if (r->used[i]) {
+            r->ev[i].wait();
+        }
+        sycl::free(r->buf[i], *stream);
+    }
+    delete r;
+}
