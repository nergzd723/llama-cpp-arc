+static ggml_sycl_staging_ring * ggml_sycl_ctx_ring(ggml_backend_sycl_context * ctx) {
+    if (ctx->staging == nullptr) {
+        ctx->staging = new ggml_sycl_staging_ring();
+        ctx->staging->tag = ctx->instance == 0 ? "cmp" : ctx->instance == 1 ? "pre" : "fix";
