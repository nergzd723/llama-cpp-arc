+#ifndef GGML_SYCL_MOE_XMX_HPP
+#define GGML_SYCL_MOE_XMX_HPP
+
+#include "common.hpp"
+
+// MoE expert GEMM on Intel XMX (joint_matrix fp16 -> fp32) for batched mul_mat_id: the quantized
+// expert weights are decoded in-kernel into a packed local-memory tile shared by 32 activation
+// rows, so every weight element is decoded once per 32 rows instead of once per row.
+#define MOE_XMX_TM 32   // activation rows per work-group
+#define MOE_XMX_TN 64   // weight rows per work-group
+
+struct moe_xmx_tile {
+    int32_t expert; // index into the stacked expert weights
+    int32_t row0;   // first (padded) row of this 32-row tile in the fp16 activation buffer and in the fp32 output
+};
+
+bool ggml_sycl_moe_xmx_supported(enum ggml_type src0_type, int64_t M, int64_t K);
+
+// A: fp16 activations, row-major [rows x K], rows padded per expert to a multiple of MOE_XMX_TM.
+// C: fp32 output, row-major [rows x M]. tiles: one entry per 32-row tile.
+void ggml_sycl_moe_xmx(enum ggml_type src0_type, const void * vx_base, size_t expert_stride_bytes,
+                       const sycl::half * A, float * C, const moe_xmx_tile * tiles, int n_tiles,
+                       int64_t M, int64_t K, dpct::queue_ptr stream);
+
+#endif
